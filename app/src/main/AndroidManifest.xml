<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest فایل معرفی برنامه به سیستم اندروید است.
  مجوزها، Application و Activity اصلی در این فایل تعریف می‌شوند.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اینترنت برای اتصال سرویس بروزرسانی، پیامک و Backend در نسخه‌های بعد لازم است. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- این مجوز برای اعلان‌های Android 13 به بالا استفاده خواهد شد. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- تنظیمات عمومی Application. -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppTime">

        <!-- MainActivity نقطه ورود اصلی برنامه است. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">

            <!-- این Intent Filter باعث نمایش برنامه در Launcher دستگاه می‌شود. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
